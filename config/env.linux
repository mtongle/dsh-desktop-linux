# Local Linux release settings for the Arch port.
#
# Upstream ships no `.env.linux` template because Linux is not a supported Desktop
# release target. Linux accepts only the shared settings — see
# scripts/desktop-package-environment.mjs, where NO_PLATFORM_SETTING = /^(?!)/u
# rejects every platform-specific key. Values below mirror the macOS/Windows templates.
DSH_DESKTOP_APP_ID=com.deepseek.harness
# production => origin is the built-in fixedOrigin (https://download.deepseek.com) and no
# DOWNLOAD_TEST_RELEASE_ID is needed; yields publicUrl
# https://download.deepseek.com/dsh-desk/feeds/linux-x64/ which is what the feed path expects.
DSH_DESKTOP_AUTO_UPDATE_ENV=production
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
